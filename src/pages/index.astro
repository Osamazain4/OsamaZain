---
const profileImage = 'https://raw.githubusercontent.com/Osamazain4/OsamaZain/main/osamazain.online/osama%20zain%20%281%29.jpg';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Osama Zain — Creative Media Specialist, Visual Content Designer, Video Editor and Motion Graphics Designer." />
    <title>Osama Zain | Creative Media Specialist</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="cursor-glow" aria-hidden="true"></div>

    <header class="nav">
      <a class="brand" href="#home">OSAMA ZAIN</a>
      <nav aria-label="Primary navigation">
        <a class="active" href="#home">Home</a>
        <a href="#portfolio">Portfolio</a>
        <a href="#experience">Experience</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main>
      <section id="home" class="hero section-shell">
        <div class="hero-copy">
          <p class="eyebrow">Creative Media Specialist</p>
          <h1>Osama <span>Zain</span></h1>
          <h2>Visual Content Designer</h2>
          <p class="intro">
            Experienced Video Editor, Motion Graphics Designer &amp; Animator.<br />
            Specializing in visual storytelling, structure, motion, and premium content creation.
          </p>
          <div class="actions">
            <a class="btn gold" href="#contact">Download CV <span>↓</span></a>
            <a class="btn outline" href="#portfolio">View Portfolio</a>
          </div>

          <div class="stats">
            <div class="stat"><strong>4+</strong><span>Awards</span></div>
            <div class="stat"><strong>50+</strong><span>Projects</span></div>
            <div class="stat"><strong>6+</strong><span>Years<br />Experience</span></div>
          </div>
        </div>

        <div class="hero-photo-wrap">
          <div class="photo-ring"></div>
          <img src={profileImage} alt="Osama Zain" class="hero-photo" />
        </div>
      </section>

      <section id="portfolio" class="content-section section-shell">
        <div class="section-heading"><p class="eyebrow">Selected Work</p><h2>Portfolio</h2></div>
        <div class="cards">
          <article class="card"><span>01</span><h3>Video Editing</h3><p>Cinematic edits, social content, documentaries and polished visual storytelling.</p></article>
          <article class="card"><span>02</span><h3>Motion Graphics</h3><p>Dynamic titles, explainers, transitions and branded motion design.</p></article>
          <article class="card"><span>03</span><h3>Animation &amp; Design</h3><p>2D animation, graphic design and creative campaign visuals.</p></article>
        </div>
      </section>

      <section id="experience" class="content-section section-shell">
        <div class="section-heading"><p class="eyebrow">Background</p><h2>Experience</h2></div>
        <div class="experience-grid">
          <div class="experience-item"><strong>ULAB TV</strong><span>News &amp; Program Production</span><p>Creative production, news coverage, editing, graphics and program work.</p></div>
          <div class="experience-item"><strong>Animekotha</strong><span>Animation &amp; Creative Production</span><p>2D animation, storytelling, script development and visual production.</p></div>
          <div class="experience-item"><strong>Creative Media</strong><span>Video • Motion • Design</span><p>End-to-end visual content creation for digital and professional projects.</p></div>
        </div>
      </section>

      <section id="contact" class="contact section-shell">
        <p class="eyebrow">Let's Work Together</p>
        <h2>Have a project in mind?</h2>
        <p>Let's turn your idea into something visually memorable.</p>
        <div class="contact-actions">
          <a class="btn gold" href="mailto:zainofficialbd@gmail.com">Email Me</a>
          <a class="btn outline" href="https://wa.me/8801620468661" target="_blank" rel="noreferrer">WhatsApp</a>
        </div>
      </section>
    </main>

    <footer>© 2026 Osama Zain. All rights reserved.</footer>

    <button class="sound" type="button" aria-label="Toggle sound" title="Sound">◖)))</button>

    <script>
      const glow = document.querySelector('.cursor-glow');
      window.addEventListener('pointermove', (event) => {
        document.documentElement.style.setProperty('--mx', `${event.clientX}px`);
        document.documentElement.style.setProperty('--my', `${event.clientY}px`);
        if (glow) glow.style.opacity = '1';
      });
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) {
    margin: 0;
    font-family: 'Inter', Arial, sans-serif;
    color: #f7f3e9;
    background: #090909;
    overflow-x: hidden;
  }
  :global(body)::before {
    content: '';
    position: fixed;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(circle at 78% 35%, rgba(255, 196, 0, .11), transparent 32%), radial-gradient(circle at 20% 65%, rgba(255, 196, 0, .055), transparent 30%);
    z-index: -2;
  }
  :global(body)::after {
    content: '';
    position: fixed;
    inset: 0;
    pointer-events: none;
    background-image: linear-gradient(rgba(255,255,255,.012) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.012) 1px, transparent 1px);
    background-size: 55px 55px;
    mask-image: linear-gradient(to bottom, black, transparent 85%);
    z-index: -1;
  }
  :global(a) { color: inherit; text-decoration: none; }

  .cursor-glow {
    position: fixed;
    width: 260px;
    height: 260px;
    left: var(--mx, 50%);
    top: var(--my, 40%);
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255,195,0,.09), transparent 68%);
    pointer-events: none;
    z-index: 0;
    opacity: 0;
    transition: opacity .2s;
  }

  .nav {
    height: 65px;
    padding: 0 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(255,196,0,.22);
    background: rgba(7,7,7,.88);
    backdrop-filter: blur(14px);
    position: sticky;
    top: 0;
    z-index: 20;
  }
  .brand { font-weight: 800; letter-spacing: 2px; font-size: 21px; text-shadow: 0 0 18px rgba(255,196,0,.18); }
  .nav nav { display: flex; gap: 30px; align-items: center; }
  .nav nav a { color: #d6d2c9; font-size: 14px; transition: .2s; }
  .nav nav a:hover, .nav nav a.active { color: #ffd000; }

  .section-shell { width: min(1180px, calc(100% - 64px)); margin: 0 auto; }
  .hero { min-height: calc(100vh - 65px); display: grid; grid-template-columns: 1.12fr .88fr; gap: 50px; align-items: center; padding: 72px 0 80px; }
  .hero-copy { position: relative; z-index: 2; }
  .eyebrow { margin: 0 0 18px; color: #ffd000; font-size: 15px; font-weight: 600; letter-spacing: .2px; }
  h1 { margin: 0; font-size: clamp(60px, 7vw, 92px); line-height: .98; letter-spacing: -4px; font-weight: 800; }
  h1 span { color: #ffbf00; text-shadow: 0 0 30px rgba(255,191,0,.18); }
  .hero h2 { margin: 17px 0 22px; font-size: clamp(26px, 3vw, 34px); color: #e8e6e0; }
  .intro { color: #b9b7b0; line-height: 1.75; font-size: 16px; max-width: 610px; }
  .actions, .contact-actions { display: flex; gap: 12px; margin-top: 27px; flex-wrap: wrap; }
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 9px; min-height: 55px; padding: 0 27px; border-radius: 30px; font-weight: 700; transition: .25s; }
  .btn.gold { background: #ffc629; color: #0a0a0a; box-shadow: 0 8px 30px rgba(255,198,41,.22); }
  .btn.gold:hover { transform: translateY(-3px); box-shadow: 0 12px 35px rgba(255,198,41,.35); }
  .btn.outline { border: 1px solid rgba(255,255,255,.22); color: #f4f1e9; }
  .btn.outline:hover { border-color: #ffc629; color: #ffc629; transform: translateY(-3px); }

  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 32px; max-width: 600px; }
  .stat { min-height: 138px; padding: 25px 18px; border: 1px solid rgba(255,196,0,.22); border-radius: 17px; background: linear-gradient(145deg, rgba(255,255,255,.045), rgba(255,196,0,.025)); display: flex; flex-direction: column; justify-content: center; }
  .stat strong { color: #ffd000; font-size: 31px; margin-bottom: 10px; }
  .stat span { color: #aaa79f; font-size: 15px; line-height: 1.45; }

  .hero-photo-wrap { width: min(455px, 100%); justify-self: center; position: relative; padding: 13px; }
  .hero-photo-wrap::before { content: ''; position: absolute; inset: 0; border-radius: 34px; background: radial-gradient(circle at 50% 50%, rgba(255,205,40,.14), transparent 65%); filter: blur(20px); }
  .photo-ring { position: absolute; inset: 0; border: 1px solid rgba(255,196,0,.28); border-radius: 34px; box-shadow: 0 0 25px rgba(255,196,0,.06); }
  .hero-photo { position: relative; display: block; width: 100%; aspect-ratio: 1 / 1.12; object-fit: cover; object-position: center; border-radius: 26px; border: 1px solid rgba(255,255,255,.08); filter: saturate(.94) contrast(1.03); }

  .content-section { padding: 110px 0 30px; }
  .section-heading h2, .contact h2 { font-size: clamp(38px, 5vw, 62px); margin: 0; letter-spacing: -2px; }
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 35px; }
  .card { padding: 30px; min-height: 210px; border: 1px solid rgba(255,196,0,.17); border-radius: 20px; background: rgba(255,255,255,.035); transition: .3s; }
  .card:hover { transform: translateY(-6px); border-color: rgba(255,196,0,.42); box-shadow: 0 20px 50px rgba(0,0,0,.3); }
  .card span { color: #ffd000; font-size: 13px; }
  .card h3 { font-size: 24px; margin: 24px 0 12px; }
  .card p, .experience-item p, .contact > p:not(.eyebrow) { color: #a9a69e; line-height: 1.7; }

  .experience-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 35px; }
  .experience-item { border-left: 2px solid #ffc629; padding: 10px 0 10px 22px; }
  .experience-item strong { display: block; font-size: 22px; }
  .experience-item span { display: block; color: #ffd000; margin-top: 7px; font-size: 14px; }

  .contact { text-align: center; padding: 150px 0 110px; }
  .contact > p:not(.eyebrow) { max-width: 600px; margin: 18px auto 0; }
  .contact-actions { justify-content: center; }
  footer { text-align: center; color: #77746d; padding: 28px 20px 40px; border-top: 1px solid rgba(255,255,255,.06); }
  .sound { position: fixed; right: 24px; bottom: 24px; width: 54px; height: 54px; border: 0; border-radius: 50%; background: #ffd000; color: #111; font-weight: 800; cursor: pointer; box-shadow: 0 8px 30px rgba(255,208,0,.25); z-index: 10; }

  @media (max-width: 850px) {
    .nav { padding: 0 18px; }
    .nav nav { gap: 14px; }
    .nav nav a { font-size: 12px; }
    .section-shell { width: min(100% - 36px, 650px); }
    .hero { grid-template-columns: 1fr; padding-top: 55px; text-align: center; }
    .intro { margin-left: auto; margin-right: auto; }
    .actions, .stats { justify-content: center; margin-left: auto; margin-right: auto; }
    .hero-photo-wrap { grid-row: 1; width: min(370px, 90%); }
    .hero-copy { grid-row: 2; }
    .cards, .experience-grid { grid-template-columns: 1fr; }
    .stat { min-height: 120px; }
  }
  @media (max-width: 520px) {
    .brand { font-size: 17px; }
    .nav nav a:nth-child(3) { display: none; }
    h1 { font-size: 58px; letter-spacing: -3px; }
    .stats { gap: 8px; }
    .stat { padding: 18px 8px; }
    .stat strong { font-size: 25px; }
    .stat span { font-size: 12px; }
  }
</style>
